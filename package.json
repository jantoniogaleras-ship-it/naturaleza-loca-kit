    "@remotion/media-utils": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@remotion/vercel": "4.0.537",
    "@vercel/blob": "2.8.2",
    "@vercel/sandbox": "1.6.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
