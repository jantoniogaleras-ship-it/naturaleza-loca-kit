{
  "name": "naturaleza-loca-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "studio": "remotion studio remotion/index.ts",
    "bundle": "remotion bundle remotion/index.ts --out-dir build/remotion-bundle",
    "build": "npm run bundle && next build",
    "render:ejemplo": "remotion render remotion/index.ts Short out/ejemplo-pulpo.mp4 --props=data/ejemplo-pulpo.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@remotion/bundler": "4.0.537",
